# =============================================================================
# Thalassa — Variables de entorno (plantilla)
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio (está en .gitignore).
# =============================================================================

# JWT — Genera valores seguros con: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=

# Base de datos PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=

# Scraper IA (Groq) — https://console.groq.com/keys
GROQ_API_KEY=

# CORS — orígenes permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=

# Perfil Spring activo
SPRING_PROFILES_ACTIVE=

# Traefik — dominio y ACME (Let's Encrypt)
DOMAIN=
ACME_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
