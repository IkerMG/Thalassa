# =============================================================================
# Thalassa — Variables de entorno (plantilla)
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio (está en .gitignore).
# =============================================================================

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=

# Base de datos PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=

# Scraper IA (Groq)
GROQ_API_KEY=

# CORS (prod — lista separada por comas, ej: https://thalassa.app)
CORS_ALLOWED_ORIGINS=

# Perfil Spring activo: dev | prod
SPRING_PROFILES_ACTIVE=
